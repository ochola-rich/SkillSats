# Default connection string for the PostgreSQL container in compose.yaml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillsats"

# Secret used to sign authentication cookies.
# Replace this with a long, random value in every deployed environment.
# Example generator: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

# Optional LND REST connection. Leave these values empty to run without Lightning.
LND_REST_HOST=""

# Use either a hex-encoded macaroon or a local macaroon file path.
# The macaroon needs permission to create and inspect invoices, decode payment
# requests, and send payments. Never commit a real macaroon.
LND_MACAROON=""
LND_MACAROON_PATH=""

# Optional CA certificate for LND HTTPS. Recommended for production.
# Development falls back to accepting LND's self-signed certificate when empty.
LND_TLS_CERT_PATH=""

# Optional second LND node used by `npm run lightning:*` during local integration tests.
# `npm run lightning:up` generates these values in `.local-lightning/app.env`.
DEV_LND_PAYER_REST_HOST=""
DEV_LND_PAYER_MACAROON=""
DEV_LND_PAYER_MACAROON_PATH=""
DEV_LND_PAYER_TLS_CERT_PATH=""

# Optional. Vite and the deployment runtime normally set this automatically.
# NODE_ENV="development"
