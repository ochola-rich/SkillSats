{
  "name": "skillsats",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:lightning": "bash scripts/lightning-docker.sh up && set -a; . ./.local-lightning/app.env; set +a; vite dev",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:logs": "docker compose logs -f postgres",
    "lightning:up": "bash scripts/lightning-docker.sh up",
    "lightning:down": "bash scripts/lightning-docker.sh down",
    "lightning:logs": "bash scripts/lightning-docker.sh logs",
    "lightning:reset": "bash scripts/lightning-docker.sh reset",
    "lightning:check": "tsx scripts/lightning-dev.ts check",
    "lightning:test": "tsx scripts/lightning-dev.ts test",
    "lightning:pay": "tsx scripts/lightning-dev.ts pay",
    "lightning:invoice": "tsx scripts/lightning-dev.ts invoice",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test src/**/*.test.ts",
    "format": "prettier --write --ignore-unknown .env.example .prettierrc '*.{js,json,md,ts,yaml,yml}' 'docs/**/*' 'prisma/**/*' 'scripts/**/*' 'src/**/*'",
    "format:check": "prettier --check --ignore-unknown .env.example .prettierrc '*.{js,json,md,ts,yaml,yml}' 'docs/**/*' 'prisma/**/*' 'scripts/**/*' 'src/**/*'",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13"
  }
}
